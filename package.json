{
  "name": "@fastagent/co2",
  "version": "0.1.0",
  "description": "CLI gateway for translating OpenAI and Claude protocols.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.31.0",
  "homepage": "https://cnb.cool/qijia/co2",
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/qijia/co2"
  },
  "bugs": {
    "url": "https://cnb.cool/qijia/co2"
  },
  "keywords": [
    "cli",
    "openai",
    "anthropic",
    "gateway",
    "proxy"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "co2": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli/index.ts start",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test && pnpm check",
    "start": "node dist/cli/index.js start",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "commander": "^14.0.3",
    "fastify": "^5.8.2",
    "openai": "^6.27.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
